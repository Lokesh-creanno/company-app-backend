NODE_ENV=test
PORT=5000
APP_NAME=CompanyApp

# SQLite for local testing (no PostgreSQL needed)
DB_DIALECT=sqlite
DB_STORAGE=./test_database.sqlite

# Redis disabled (in-memory OTP for test)
USE_MEMORY_OTP=true

# JWT
JWT_SECRET=test_super_secret_key_for_local_dev_only
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Email — disabled in test mode (OTP printed to console)
SMTP_DISABLED=true

# AWS S3 — disabled in test mode (files saved locally)
STORAGE_LOCAL=true
LOCAL_UPLOAD_DIR=./uploads

# Firebase — disabled in test mode
FIREBASE_DISABLED=true

FRONTEND_URL=*
